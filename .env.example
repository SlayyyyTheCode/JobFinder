# ---- AI model (required) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Swap provider/models here without code changes. Providers are registered in backend/app/llm/registry.py
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro
LLM_FAST_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# ---- Gmail (optional) — see docs/SETUP_OAUTH.md ----
# Absolute path to the "Desktop app" OAuth client JSON downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRETS_FILE=

# ---- Outlook / Hotmail / Microsoft 365 (optional) — see docs/SETUP_OAUTH.md ----
MS_CLIENT_ID=
MS_AUTHORITY=https://login.microsoftonline.com/common

# ---- Hosted deployment only (see docs/DEPLOY.md). Leave unset for the desktop app. ----
# HOSTED=1
# DATABASE_URL=postgresql://user:pass@host:5432/db
# APP_PASSWORD_HASH=      # python -m app.auth hash
# SESSION_SECRET=         # python -m app.auth secret
# TOKEN_ENCRYPTION_KEY=   # python -m app.auth fernet-key
# PUBLIC_URL=https://your-app.vercel.app
# GOOGLE_CLIENT_ID=       # hosted Gmail ("Web application" client)
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_SECRET=       # hosted Outlook ("Web" registration)

# ---- Polling ----
EMAIL_POLL_MINUTES=15
JOB_POLL_MINUTES=60
MCF_MIN_INTERVAL_SECONDS=2.0
